# Copy to .env locally; never commit .env or production credentials.
# Use a unique 32+ character value in production.
JWT_SECRET="replace-with-a-long-random-secret"
# Server-only API credentials. Leave blank until configured.
GEMINI_API_KEY=""
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
# Public HTTPS origin, without a trailing slash (for example https://app.example.com).
APP_URL="https://app.example.com"
