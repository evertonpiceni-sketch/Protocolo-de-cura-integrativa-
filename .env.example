# Required for production authentication.
# Generate a cryptographically random value with at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Required for durable user/account persistence on Vercel/serverless.
# Create an Upstash Redis database and copy these values from its REST connection settings.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token
# Optional custom key:
# UPSTASH_DB_KEY=cura_integrada:database:v1

# Optional integrations
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
NODE_ENV=production
APP_URL=
